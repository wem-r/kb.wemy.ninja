{
  "name": "kb.wemy.ninja",
  "scripts": {
    "hugo": "hugo",
    "serve": "hugo server --buildDrafts --disableFastRender",
    "build": "hugo --gc --minify",
    "clean": "rm -rf public resources/_gen .hugo_build.lock",
    "prepare": "git submodule update --init && npm --prefix themes/docsy run install:theme-deps"
  },
  "devDependencies": {
    "hugo-extended": "0.166.0",
    "sass-embedded": "1.105.1"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "private": true,
  "allowScripts": {
    "hugo-extended@0.164.0": true
  }
}
